require 'fileutils'
require 'tmpdir'

opt_out_usage

ROOT = File.expand_path('..', __dir__)
PACKAGE = 'im.zuno.chat'
TEAM_ID = '5V9UP3J9CK'
LOCALE = 'en-US'
IOS_TARGETS = {
  'Runner' => 'im.zuno.chat',
  'ShareExtension' => 'im.zuno.chat.ShareExtension',
  'NotificationService' => 'im.zuno.chat.NotificationService'
}.freeze

def release_notes(version)
  path = File.join(ROOT, 'docs', 'release-notes', "#{version}.txt")
  File.read(path, encoding: 'bom|utf-8').gsub("\r\n", "\n").strip
end

def store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_P8_BASE64'),
    is_key_content_base64: true
  )
end

def write_output(values)
  File.open(ENV.fetch('GITHUB_OUTPUT'), 'a') do |file|
    values.each { |key, value| file.puts("#{key}=#{value}") }
  end
end

platform :android do
  lane :upload do |options|
    dry_run = options[:dry_run].to_s == 'true'
    metadata = Dir.mktmpdir
    unless dry_run
      changelogs = File.join(metadata, LOCALE, 'changelogs')
      FileUtils.mkdir_p(changelogs)
      File.write(
        File.join(changelogs, "#{options.fetch(:build_number)}.txt"),
        release_notes(options.fetch(:version))
      )
    end
    upload_to_play_store(
      package_name: PACKAGE,
      json_key_data: ENV.fetch('PLAY_JSON'),
      track: 'production',
      release_status: 'inProgress',
      rollout: '0.01',
      aab: options.fetch(:aab),
      metadata_path: metadata,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: dry_run,
      validate_only: dry_run
    )
  end

  lane :rollout_status do
    require 'supply'
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      package_name: PACKAGE,
      json_key_data: ENV.fetch('PLAY_JSON'),
      track: 'production'
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: PACKAGE)
    releases = client.tracks('production').flat_map { |track| track.releases || [] }
    client.abort_current_edit
    live = releases.find { |release| %w[inProgress halted].include?(release.status) }
    write_output(
      status: live ? live.status : 'none',
      fraction: live&.user_fraction || 0,
      version_code: live&.version_codes&.max || 0
    )
  end

  lane :rollout do |options|
    upload_to_play_store(
      package_name: PACKAGE,
      json_key_data: ENV.fetch('PLAY_JSON'),
      track: 'production',
      version_code: options.fetch(:version_code).to_i,
      rollout: options.fetch(:fraction).to_s,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :signing do
    setup_ci
    match(
      type: 'appstore',
      readonly: true,
      app_identifier: IOS_TARGETS.values,
      team_id: TEAM_ID,
      git_url: ENV.fetch('MATCH_GIT_URL'),
      git_basic_authorization: ENV.fetch('MATCH_GIT_BASIC_AUTHORIZATION'),
      api_key: store_api_key
    )
    IOS_TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        path: File.join(ROOT, 'ios', 'Runner.xcodeproj'),
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ['Release'],
        team_id: TEAM_ID,
        code_sign_identity: 'Apple Distribution',
        profile_name: "match AppStore #{bundle_id}"
      )
    end
  end

  lane :upload do |options|
    api_key = store_api_key
    if options[:dry_run].to_s == 'true'
      upload_to_app_store(
        api_key: api_key,
        app_identifier: PACKAGE,
        ipa: options.fetch(:ipa),
        verify_only: true,
        force: true
      )
    else
      version = options.fetch(:version)
      build_number = options.fetch(:build_number).to_s
      uploaded = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: PACKAGE,
        version: version,
        platform: 'ios',
        initial_build_number: 0
      ).to_s == build_number
      binary = uploaded ? { build_number: build_number, skip_binary_upload: true } : { ipa: options.fetch(:ipa) }
      metadata = Dir.mktmpdir
      FileUtils.mkdir_p(File.join(metadata, LOCALE))
      File.write(File.join(metadata, LOCALE, 'release_notes.txt'), release_notes(version))
      upload_to_app_store(
        api_key: api_key,
        app_identifier: PACKAGE,
        app_version: version,
        metadata_path: metadata,
        skip_screenshots: true,
        submit_for_review: true,
        reject_if_possible: true,
        automatic_release: true,
        phased_release: true,
        run_precheck_before_submit: false,
        force: true,
        submission_information: { add_id_info_uses_idfa: false },
        **binary
      )
    end
  end
end

    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruger mikrofonen til opkald, talebeskeder og videoer, du optager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno nutzt das Mikrofon für Anrufe, Sprachnachrichten und Videos, die du aufnimmst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί το μικρόφωνο για κλήσεις, φωνητικά μηνύματα και τα βίντεο που τραβάτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses the microphone for calls, voice messages and videos you record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa el micrófono para las llamadas, los mensajes de voz y los vídeos que grabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno utilise le micro pour les appels, les messages vocaux et les vidéos que vous enregistrez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa il microfono per le chiamate, i messaggi vocali e i video che registri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruker mikrofonen til anrop, talemeldinger og videoer du tar opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno gebruikt de microfoon voor oproepen, spraakberichten en video’s die je opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno używa mikrofonu do połączeń, wiadomości głosowych i nagrywanych filmów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa o microfone para chamadas, mensagens de voz e vídeos que você grava."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa o microfone para chamadas, mensagens de voz e vídeos que grava."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno përdor mikrofonin për thirrjet, mesazhet zanore dhe videot që regjistron."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno använder mikrofonen för samtal, röstmeddelanden och videor du spelar in."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno gemmer kun billeder og videoer i dit bibliotek, når du trykker på “Gem”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno speichert Fotos und Videos nur dann in deiner Mediathek, wenn du auf „Speichern“ tippst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno αποθηκεύει φωτογραφίες και βίντεο στη βιβλιοθήκη σας μόνο όταν πατάτε «Αποθήκευση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno saves photos and videos to your library only when you tap Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno guarda fotos y vídeos en tu fototeca solo cuando tocas «Guardar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno enregistre des photos et des vidéos dans votre photothèque uniquement quand vous touchez « Enregistrer »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno salva foto e video nella tua libreria solo quando tocchi «Salva»."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno lagrer bilder og videoer i biblioteket ditt bare når du trykker på «Lagre»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bewaart foto’s en video’s alleen in je bibliotheek als je op ‘Opslaan’ tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno zapisuje zdjęcia i filmy w Twojej bibliotece tylko wtedy, gdy dotkniesz „Zapisz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno salva fotos e vídeos na sua galeria só quando você toca em “Salvar”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno guarda fotografias e vídeos na sua fototeca só quando toca em «Guardar»."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno i ruan fotot dhe videot në bibliotekën tënde vetëm kur prek “Ruaj”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno sparar bilder och videor i ditt bibliotek bara när du trycker på ”Spara”."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruger kun de billeder og videoer, du vælger, til at sende dem eller til at angive et profil- eller rumbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno nutzt nur die Fotos und Videos, die du auswählst, um sie zu senden oder als Profil- oder Raumbild festzulegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί μόνο τις φωτογραφίες και τα βίντεο που επιλέγετε, για να τα στείλετε ή για να ορίσετε φωτογραφία προφίλ ή αίθουσας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses only the photos and videos you choose, to send them or to set a profile or room photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa solo las fotos y los vídeos que eliges, para enviarlos o ponerlos como foto de perfil o de una sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno utilise uniquement les photos et vidéos que vous choisissez, pour les envoyer ou pour définir une photo de profil ou de salon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa solo le foto e i video che scegli, per inviarli o impostarli come foto del profilo o della stanza."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruker bare bildene og videoene du velger, for å sende dem eller angi et profil- eller rombilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno gebruikt alleen de foto’s en video’s die je kiest, om ze te versturen of als profiel- of kamerfoto in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno używa tylko wybranych przez Ciebie zdjęć i filmów, aby je wysłać lub ustawić zdjęcie profilowe albo zdjęcie pokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa só as fotos e vídeos que você escolher, para enviá-los ou para definir uma foto do perfil ou da sala."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa só as fotografias e vídeos que escolher, para os enviar ou para definir uma fotografia de perfil ou de sala."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno përdor vetëm fotot dhe videot që zgjedh ti, për t’i dërguar ose për të vendosur një foto profili ose dhome."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno använder bara de bilder och videor du väljer, för att skicka dem eller för att ange en profil- eller rumsbild."
          }
        }
      }
    }
  },
  "version" : "1.0"
}

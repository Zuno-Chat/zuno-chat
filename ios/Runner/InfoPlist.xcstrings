{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruger kameraet til videoopkald, til billeder og videoer, du tager, og til at scanne login- og verificeringskoder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno nutzt die Kamera für Videoanrufe, für Fotos und Videos, die du aufnimmst, und zum Scannen von Anmelde- und Verifizierungscodes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί την κάμερα για βιντεοκλήσεις, για τις φωτογραφίες και τα βίντεο που τραβάτε και για τη σάρωση κωδικών σύνδεσης και επαλήθευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses the camera for video calls, photos and videos you take, and scanning sign-in and verification codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa la cámara para las videollamadas, las fotos y los vídeos que haces, y para escanear códigos de inicio de sesión y de verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno utilise la caméra pour les appels vidéo, les photos et vidéos que vous prenez, et pour scanner les codes de connexion et de vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa la fotocamera per le videochiamate, per le foto e i video che fai e per scansionare i codici di accesso e di verifica."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruker kameraet til videoanrop, til bilder og videoer du tar, og til å skanne påloggings- og verifiseringskoder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno gebruikt de camera voor video-oproepen, foto’s en video’s die je maakt, en het scannen van inlog- en verificatiecodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno używa kamery do połączeń wideo, robienia zdjęć i filmów oraz skanowania kodów logowania i weryfikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa a câmera para chamadas de vídeo, para as fotos e vídeos que você tira e para escanear códigos de login e de verificação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa a câmara para videochamadas, para as fotografias e vídeos que tira e para ler códigos de início de sessão e de verificação."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno përdor kamerën për thirrjet me video, për fotot dhe videot që bën, si dhe për të skanuar kodet e identifikimit dhe të verifikimit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno använder kameran för videosamtal, för bilder och videor du tar och för att skanna inloggnings- och verifieringskoder."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruger kun din placering, når du sender den eller deler den live i en chat eller et rum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno nutzt deinen Standort nur, wenn du ihn in einem Chat oder Raum sendest oder live teilst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί την τοποθεσία σας μόνο όταν τη στέλνετε ή την κοινοποιείτε ζωντανά σε μια συνομιλία ή αίθουσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses your location only when you send it or share it live in a chat or room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa tu ubicación solo cuando la envías o la compartes en tiempo real en un chat o una sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno utilise votre position uniquement quand vous l’envoyez ou la partagez en direct dans une conversation ou un salon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno usa la tua posizione solo quando la invii o la condividi in tempo reale in una chat o in una stanza."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno bruker posisjonen din bare når du sender den eller deler den i sanntid i en chat eller et rom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno gebruikt je locatie alleen als je die verstuurt of live deelt in een chat of kamer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno używa Twojej lokalizacji tylko wtedy, gdy ją wysyłasz lub udostępniasz na żywo w czacie albo pokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa sua localização só quando você a envia ou compartilha em tempo real em uma conversa ou sala."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zuno usa a sua localização só quando a envia ou a partilha em tempo real numa conversa ou sala."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno përdor vendndodhjen tënde vetëm kur e dërgon ose e ndan drejtpërdrejt në një bisedë ose dhomë."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno använder din plats bara när du skickar den eller delar den live i en chatt eller ett rum."
          }
        }
      }
    },

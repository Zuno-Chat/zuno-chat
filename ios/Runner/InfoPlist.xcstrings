{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί την κάμερα για βιντεοκλήσεις, για τις φωτογραφίες και τα βίντεο που τραβάτε και για τη σάρωση κωδικών σύνδεσης και επαλήθευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses the camera for video calls, photos and videos you take, and scanning sign-in and verification codes."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί την τοποθεσία σας μόνο όταν τη στέλνετε ή την κοινοποιείτε ζωντανά σε μια συνομιλία ή αίθουσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses your location only when you send it or share it live in a chat or room."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί την τοποθεσία σας μόνο όταν τη στέλνετε ή την κοινοποιείτε ζωντανά σε μια συνομιλία ή αίθουσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses your location only when you send it or share it live in a chat or room."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί το μικρόφωνο για κλήσεις, φωνητικά μηνύματα και τα βίντεο που τραβάτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses the microphone for calls, voice messages and videos you record."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno αποθηκεύει φωτογραφίες και βίντεο στη βιβλιοθήκη σας μόνο όταν πατάτε «Αποθήκευση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno saves photos and videos to your library only when you tap Save."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Zuno χρησιμοποιεί μόνο τις φωτογραφίες και τα βίντεο που επιλέγετε, για να τα στείλετε ή για να ορίσετε φωτογραφία προφίλ ή αίθουσας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuno uses only the photos and videos you choose, to send them or to set a profile or room photo."
          }
        }
      }
    }
  },
  "version" : "1.0"
}

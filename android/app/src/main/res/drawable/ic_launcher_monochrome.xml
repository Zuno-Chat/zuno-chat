<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+ "Themed icons" setting) —
  assets/logo/ic_launcher_monochrome.svg, hand-converted the same way as
  ic_launcher_foreground.xml (identical geometry, solid black instead of
  ink). The system recolours this from the user's wallpaper palette and
  uses only its alpha, so the black here is a carrier for the shape, not
  a colour that ever ships to screen.

  Carries the same 62dp -> 45dp safe-zone correction as
  ic_launcher_foreground.xml — see that file's comment for the geometry.
  This layer is masked identically, so it would clip at the corners in
  exactly the same way if left at the source SVG's scale.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="27.837"
        android:translateY="27.837"
        android:scaleX="0.523256"
        android:scaleY="0.523256">
        <!-- Left bracket -->
        <path
            android:pathData="M44 10 H20 A10 10 0 0 0 10 20 V80 A10 10 0 0 0 20 90 H44"
            android:strokeColor="#000000"
            android:strokeWidth="6"
            android:fillColor="#00000000" />
        <!-- Right bracket -->
        <path
            android:pathData="M56 10 H80 A10 10 0 0 1 90 20 V80 A10 10 0 0 1 80 90 H56"
            android:strokeColor="#000000"
            android:strokeWidth="6"
            android:fillColor="#00000000" />
        <!-- Message bubble carrying the knocked-out Z -->
        <group
            android:translateX="23.91"
            android:translateY="23.12"
            android:scaleX="0.522"
            android:scaleY="0.522">
            <path
                android:pathData="M4 26 A20 20 0 0 1 24 6 H76 A20 20 0 0 1 96 26 V60 A20 20 0 0 1 76 80 H44 L22 97 V80 H24 A20 20 0 0 1 4 60 Z M34 28 L66 28 L66 35 L49 51 L66 51 L66 58 L34 58 L34 51 L51 35 L34 35 Z"
                android:fillColor="#000000"
                android:fillType="evenOdd" />
        </group>
    </group>
</vector>
